# Vercel Container Runtime image. The self-host image stays in ./Dockerfile.
FROM rust:1-slim-bookworm AS build
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential cmake \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY Cargo.toml Cargo.lock ./
COPY src ./src
COPY migrations ./migrations
COPY templates ./templates
RUN cargo build --release --locked

FROM debian:bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates xz-utils \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 10001 --home /app dopefeed
WORKDIR /app
COPY --from=build /app/target/release/dopefeed /usr/local/bin/dopefeed
COPY static ./static
COPY data/dopefeed.db.xz /app/seed/dopefeed.db.xz
COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh && chown -R dopefeed:dopefeed /app
USER dopefeed
ENV BIND_ADDR=0.0.0.0:3000 \
    DATABASE_URL=sqlite:///tmp/dopefeed.db?mode=rwc \
    WORKER=0 \
    RUST_LOG=info
EXPOSE 3000
ENTRYPOINT ["docker-entrypoint.sh"]
